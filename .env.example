# Copy this file to ".env" and change the values marked CHANGE ME.
# Never commit ".env" to Git. Only ".env.example" is committed.
# Do not put quotes around values.

# --- General ---
ENVIRONMENT=development

# --- Database (PostgreSQL + pgvector) ---
POSTGRES_USER=heimdall
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=heimdall
# The password here must match POSTGRES_PASSWORD above.
DATABASE_URL=postgresql+asyncpg://heimdall:CHANGE_ME@localhost:5432/heimdall

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Security ---
SECRET_KEY=CHANGE_ME_to_a_long_random_string
SESSION_COOKIE_NAME=heimdall_session
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# --- LLM (local, through Ollama) ---
LLM_BASE_URL=http://localhost:11434
LLM_MODEL_NAME=qwen3:4b
LLM_API_KEY=
# Qwen3 can print long "thinking" text. Keep this false for RAG.
LLM_THINK=false
# Context window in tokens. Keep modest so the model stays on the GPU.
LLM_NUM_CTX=4096

# --- Embeddings and reranker (run locally through Python) ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Retrieval (starting values; tune with the evaluation set) ---
RETRIEVAL_TOP_K=20
RERANK_TOP_K=5
# Placeholder only. Choose the real threshold from your evaluation results.
SIMILARITY_THRESHOLD=0.30

# --- Documents ---
STORAGE_PATH=./storage
MAX_UPLOAD_MB=10
ALLOWED_FILE_TYPES=pdf,txt,md
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=75

# --- Limits and retention ---
MAX_ACTIVE_KEYS_PER_TENANT=5
RATE_LIMIT_PER_MINUTE=60
MONTHLY_QUERY_QUOTA=1000
TRACE_RETENTION_DAYS=30
